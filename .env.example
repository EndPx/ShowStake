# ShowStake environment — PLACEHOLDERS ONLY. Copy to .env for local work.
# Never commit a real .env and never put real credentials in this example file.
# All values below are placeholders; none are real endpoints, keys, or identifiers.

# --- Disposable PostgreSQL (ShowStake-specific, isolated) ---
# Use scripts/postgres-disposable/ to create/teardown a disposable instance.
# Replace USERNAME/PASSWORD/DB NAME with the disposable values only.
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/SHOWSTAKE_DISPOSABLE_DB

# --- Environment selector ---
# local | testnet | mainnet
SHOWSTAKE_ENVIRONMENT=local

# --- NEAR identifiers are NOT finalized (T02 gate). Leave as placeholders. ---
SHOWSTAKE_NEAR_NETWORK=<unset-until-T02>
SHOWSTAKE_CONTRACT_ID=<unset-until-T02>
SHOWSTAKE_FT_CONTRACT_ID=<unset-until-T02>

# --- Provider / model selection is managed by the harness profile, not this file.
# Never duplicate a provider API key here; it belongs in a secret store.