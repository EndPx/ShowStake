# Normalize line endings across Windows/WSL/macOS/Linux. Source and docs stay LF.
* text=auto

*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.css     text eol=lf
*.py      text eol=lf
*.rs      text eol=lf
*.sh      text eol=lf
deploy/vps/*.service text eol=lf
deploy/vps/*.timer text eol=lf
deploy/vps/*.env.example text eol=lf
*.toml    text eol=lf

# PowerShell scripts keep native CRLF on Windows.
*.ps1     text eol=crlf

# Lockfile is text and normalized.
pnpm-lock.yaml text eol=lf
**/Cargo.lock text eol=lf
*.wasm binary

# VALIDATION.json is an immutable generated artifact whose recorded provenance
# hash (docs/evidence/bootstrap.json) pins its CRLF checkout bytes (the verifier
# hashes raw bytes). Override the *.json eol=lf rule so a default Windows clone
# reproduces those exact bytes instead of the normalized-LF blob.
docs/planning/showstake-v2/VALIDATION.json text eol=crlf
