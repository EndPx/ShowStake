# Isolated local/Sandbox verification only. Never mount credentials or a Docker socket.
FROM rust:1.99.1-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev cmake clang nasm curl ca-certificates \
    python3 xz-utils && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown --toolchain 1.99.1
RUN mkdir -p /opt/binaryen && cd /opt/binaryen && \
    curl -fsSL https://github.com/WebAssembly/binaryen/releases/download/version_120/binaryen-version_120-x86_64-linux.tar.gz -o release.tar.gz && \
    curl -fsSL https://github.com/WebAssembly/binaryen/releases/download/version_120/binaryen-version_120-x86_64-linux.tar.gz.sha256 -o release.sha256 && \
    expected="$(cut -d ' ' -f1 release.sha256)" && \
    printf '%s  release.tar.gz\n' "$expected" | sha256sum --check - && \
    tar -xzf release.tar.gz --strip-components=1 && rm release.tar.gz
ENV PATH="/opt/binaryen/bin:${PATH}" CARGO_BUILD_JOBS=2 RUSTUP_TOOLCHAIN=1.99.1
WORKDIR /work
