[Unit]
Description=ShowStake finalized-chain projection worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=showstake-worker
Group=showstake-worker
WorkingDirectory=/opt/showstake/current
EnvironmentFile=/etc/showstake/worker.env
ExecStart=/opt/showstake/tools/node-v24.18.0-linux-x64/bin/node /opt/showstake/current/apps/worker/dist/cli.js --watch
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
