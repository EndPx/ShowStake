{
  "name": "showstake",
  "version": "0.0.0",
  "private": true,
  "description": "ShowStake v2 \u2014 NEAR-centered event attendance commitment platform. T00/T01 database + bootstrap foundation only; wallet/intents/UI implementation is a separate, later acceptance (its commands live in each package's own manifest, not at the root).",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=10.21.0 <11"
  },
  "scripts": {
    "verify": "node scripts/verify-bootstrap.mjs && node scripts/verify-packet.mjs",
    "verify:packet": "node scripts/verify-packet.mjs",
    "verify:bootstrap": "node scripts/verify-bootstrap.mjs",
    "verify:packet-verifier": "node scripts/run-packet-verifier.mjs",
    "verify:domain": "node packages/domain/verify.mjs",
    "verify:baseline": "node migrations/verify-baseline.mjs",
    "verify:openapi": "node scripts/verify-openapi.mjs",
    "verify:t01-aggregate": "node scripts/verify-t01-aggregate.mjs",
    "verify:t01-static": "node packages/domain/verify.mjs && node migrations/verify-baseline.mjs && node scripts/verify-t01-aggregate.mjs && node scripts/verify-openapi.mjs",
    "dev:t02-harness": "vite apps/web/onboarding-probe",
    "build:t02-harness": "vite build apps/web/onboarding-probe",
    "verify:t02-harness": "node scripts/verify-t02-harness.mjs",
    "verify:t02-regressions": "node scripts/verify-t02-regressions.mjs",
    "verify:t02-review-gaps": "node scripts/verify-t02-review-gaps.mjs",
    "verify:t02-adversarial": "node scripts/verify-t02-adversarial.mjs",
    "verify:nep413-official": "node packages/wallet-adapter/verify-nep413-official.mjs",
    "verify:wallet": "node packages/wallet-adapter/src/cli.mjs",
    "migrations:up": "node migrations/cli.mjs up",
    "migrations:status": "node migrations/cli.mjs status",
    "verify:t01": "wsl -d Ubuntu -- bash scripts/postgres-disposable/run-suite.sh",
    "typecheck:api": "pnpm --filter @showstake/api typecheck",
    "build:api": "pnpm --filter @showstake/api build",
    "verify:api": "pnpm --filter @showstake/api typecheck && pnpm --filter @showstake/api build && node scripts/verify-api.mjs",
    "verify:api-db": "pnpm --filter @showstake/api build && wsl -d Ubuntu -- bash scripts/postgres-disposable/run-api-suite.sh",
    "dev:web": "pnpm --filter @showstake/web dev",
    "build:web": "pnpm --filter @showstake/web build",
    "typecheck:web": "pnpm --filter @showstake/web typecheck",
    "verify:t08-frontend": "node scripts/verify-t08-frontend.mjs",
    "verify:frontend-slice": "node scripts/verify-frontend-slice.mjs"
  },
  "devDependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "near-api-js": "7.4.0",
    "vite": "8.3.6",
    "js-yaml": "4.1.0",
    "openapi-schema-validator": "12.1.3",
    "pg": "8.23.1"
  }
}
